# Copy to .env for local development. NEVER commit real credentials.

PORT=8080
FIREBASE_PROJECT_ID=ora-app-d8112

# Path to a Firebase Admin service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts.
# Do NOT put this file in the Flutter mobile/ tree.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# App Check is required in production (architecture ADR-014).
# development / local emulator: false
# staging: true once client App Check works end-to-end
# production: true
REQUIRE_APP_CHECK=false

# Optional: override rate limit (defaults: 60 req / 60s per verified uid+ip)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
