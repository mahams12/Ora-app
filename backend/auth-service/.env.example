# Copy to .env for local development. NEVER commit real credentials.

PORT=8080
FIREBASE_PROJECT_ID=ora-app-d8112

# Path to a Firebase Admin service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts.
# Do NOT put this file in the Flutter mobile/ tree.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# App Check is required in production (architecture ADR-014).
# development / local emulator: false
# staging: true once client App Check works end-to-end
# production: true
REQUIRE_APP_CHECK=false

# Optional: override rate limit (defaults: 60 req / 60s per verified uid+ip)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Google Routes / Geocoding — server only (Phase 4B/5B). NEVER put this in Flutter.
# Restrict the key to Routes API (+ Geocoding if used) and IP/service account.
# GOOGLE_MAPS_SERVER_KEY=

# Staging Cloud Run (optional)
# ORA_ENV=staging
# NODE_ENV=staging
# REDIS_URL=redis://...   # optional locally; staging Cloud Run uses Secret Manager ora-staging-redis-url + VPC (see scripts/wire_staging_redis.sh)
# ORA_INTERNAL_WORKER_TOKEN=...   # required for staging deploy; synced to Secret Manager ora-staging-internal-worker-token (wire_staging_server_secrets.sh)
# GOOGLE_MAPS_SERVER_KEY synced to Secret Manager ora-staging-google-maps-server-key on deploy (not plain Cloud Run env)
# GCP_PROJECT_ID=ora-app-d8112
# GCP_REGION=us-central1

# Production App Check smoke (local only — never commit):
# PRODUCTION_APP_CHECK_DEBUG_SECRET=<UUID4 registered via scripts/register_production_app_check_debug.sh>
# Optional short-lived JWT override (discouraged): PRODUCTION_APP_CHECK_DEBUG_TOKEN=
