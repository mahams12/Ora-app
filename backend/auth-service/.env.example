# Copy to .env for local development. NEVER commit real credentials.

PORT=8080
FIREBASE_PROJECT_ID=ora-app-d8112

# L2 Step 2 — Firebase Realtime Database URL (optional until live location publish).
# Console → Realtime Database → copy database URL (e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app).
# Never put this secret material in Flutter; Admin SDK uses application-default credentials.
# FIREBASE_DATABASE_URL=https://ora-app-d8112-default-rtdb.asia-southeast1.firebasedatabase.app

# Path to a Firebase Admin service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts.
# Do NOT put this file in the Flutter mobile/ tree.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# App Check is required in production (architecture ADR-014).
# development / local emulator: false
# staging: true once client App Check works end-to-end
# production: true
REQUIRE_APP_CHECK=false

# Optional: override rate limit (defaults: 60 req / 60s per verified uid+ip)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Google Routes / Geocoding — server only (Phase 4B/5B). NEVER put this in Flutter.
# Restrict the key to Routes API (+ Geocoding if used) and IP/service account.
# GOOGLE_MAPS_SERVER_KEY=

# Staging Cloud Run (optional)
# ORA_ENV=staging
# NODE_ENV=staging
# Geo store backend: firestore (default, production) | rtdb (geoPresence geohash index).
# rtdb requires FIREBASE_DATABASE_URL; unknown/unsupported values refuse startup.
# Local dev scripts default GEO_BACKEND=rtdb; rollback: GEO_BACKEND=firestore.
# GEO_BACKEND=firestore
# locationStreams cursor store: defaults to GEO_BACKEND pairing; set explicitly
# to mix (e.g. GEO_BACKEND=firestore + LOCATION_STREAMS_BACKEND=rtdb).
# LOCATION_STREAMS_BACKEND=rtdb
# Cost-optimization flags (default off = current behavior):
# LOCATION_ADAPTIVE_FRESHNESS=true honors the client's declared publishIntervalMs —
# marker expiry becomes lastLocationTs + interval + 15s grace (clamped 4–60s)
# and the geo query filters on the freshUntilMs twin. Requires the
# geoDrivers freshUntilMs composite indexes (firestore.indexes.json).
# LOCATION_IDLE_MERGED_CURSOR=true folds idle-stream seq validation into the
# geoDrivers marker write (one billed tx per packet instead of two).
# Firestore geo backend only; unsupported clients fall back automatically.
# LOCATION_ADAPTIVE_FRESHNESS=false
# LOCATION_IDLE_MERGED_CURSOR=false
# PRICING_RULES_CACHE_TTL_MS — in-process TTL for pricingRules docs
# (rules are admin-seeded; 60s staleness is safe because the estimate
# snapshot already freezes the rule per booking). 0/empty = uncached.
# PRICING_RULES_CACHE_TTL_MS=60000
# Geo store is Firestore-native (geoDrivers collection) — no REDIS_URL or VPC connector.
# ORA_INTERNAL_WORKER_TOKEN=...   # required for staging deploy; synced to Secret Manager ora-staging-internal-worker-token (wire_staging_server_secrets.sh)
# GOOGLE_MAPS_SERVER_KEY synced to Secret Manager ora-staging-google-maps-server-key on deploy (not plain Cloud Run env)
# GCP_PROJECT_ID=ora-app-d8112
# GCP_REGION=us-central1

# Production App Check smoke (local only — never commit):
# PRODUCTION_APP_CHECK_DEBUG_SECRET=<UUID4 registered via scripts/register_production_app_check_debug.sh>
# Optional short-lived JWT override (discouraged): PRODUCTION_APP_CHECK_DEBUG_TOKEN=
