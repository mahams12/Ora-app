{
  "rules": {
    ".read": false,
    ".write": false,
    "rideAccess": {
      "$rideId": {
        ".read": false,
        ".write": false
      }
    },
    "tripLocations": {
      "$rideId": {
        ".read": "auth != null && root.child('rideAccess').child($rideId).child(auth.uid).val() === true",
        ".write": false
      }
    },
    "geoPresence": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "g",
        "expiresAtMs"
      ]
    },
    "locationStreams": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "expiresAtMs"
      ]
    },
    "rideChats": {
      "$rideId": {
        ".read": "auth != null && root.child('rideAccess').child($rideId).child(auth.uid).val() === true",
        ".write": "auth != null && root.child('rideAccess').child($rideId).child(auth.uid).val() === true",
        "messages": {
          ".indexOn": [
            "createdAtMs"
          ]
        }
      }
    }
  }
}