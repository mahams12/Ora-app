{
  "version": 8,
  "name": "Ora MapLibre PoC \u2014 disposable",
  "metadata": {
    "ora:poc": true,
    "ora:note": "DISPLAY-ONLY PoC style. Not production. MapTiler key injected at runtime."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=__MAPTILER_KEY__",
      "attribution": "<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">&copy; MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=__MAPTILER_KEY__",
  "sprite": "https://api.maptiler.com/maps/streets-v2/sprite",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F7E8DA"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#F3DFC8",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#F3DFC8",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#DCE6C4",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#F6D9BE",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#F0C9A6",
        "line-width": 1.2
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "<=",
        "admin_level",
        4
      ],
      "paint": {
        "line-color": "#DDB493",
        "line-width": 1,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "building-2d",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "maxzoom": 15,
      "paint": {
        "fill-color": "#EDD3BA",
        "fill-opacity": 0.85,
        "fill-outline-color": "#E2C2A4"
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#E8C9AC",
        "fill-extrusion-opacity": 0.9,
        "fill-extrusion-height": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0,
          15,
          [
            "coalesce",
            [
              "get",
              "render_height"
            ],
            [
              "get",
              "height"
            ],
            8
          ]
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "!=",
          "class",
          "motorway"
        ],
        [
          "!=",
          "class",
          "trunk"
        ],
        [
          "!=",
          "class",
          "primary"
        ],
        [
          "!=",
          "class",
          "rail"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D8B79A",
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              12,
              1.5
            ],
            [
              16,
              6
            ],
            [
              18,
              12
            ]
          ]
        }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "!=",
          "class",
          "motorway"
        ],
        [
          "!=",
          "class",
          "trunk"
        ],
        [
          "!=",
          "class",
          "primary"
        ],
        [
          "!=",
          "class",
          "rail"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFDF9",
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              12,
              0.8
            ],
            [
              16,
              4
            ],
            [
              18,
              9
            ]
          ]
        }
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D8B79A",
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              10,
              2
            ],
            [
              14,
              7
            ],
            [
              18,
              16
            ]
          ]
        }
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFF4E4",
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              10,
              1
            ],
            [
              14,
              4.5
            ],
            [
              18,
              12
            ]
          ]
        }
      }
    },
    {
      "id": "road-major-accent",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#F88733",
        "line-opacity": 0.22,
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              12,
              0.5
            ],
            [
              16,
              2.5
            ],
            [
              18,
              5
            ]
          ]
        }
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 8,
        "text-offset": [
          0,
          0.8
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#8A6A52",
        "text-halo-color": "#F7E8DA",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              10,
              12
            ],
            [
              14,
              16
            ]
          ]
        },
        "text-transform": "none",
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#4A382B",
        "text-halo-color": "#F7E8DA",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#96725A",
        "text-halo-color": "#F7E8DA",
        "text-halo-width": 1
      }
    }
  ]
}