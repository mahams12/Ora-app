# Copy to .env for local development. Do NOT commit .env
# Public mobile configuration only — no server secrets or Admin credentials.

ORA_ENV=development
ORA_API_BASE_URL=https://api-dev.ora.app/v1
ORA_APP_CHECK_ENABLED=false

# Client Places (dart-define) — not the Maps SDK key.
# ORA_GOOGLE_PLACES_API_KEY=

# Maps SDK for Android — put in android/local.properties (gitignored) or export:
# ORA_GOOGLE_MAPS_ANDROID_API_KEY=
# Never put the server Routes key (GOOGLE_MAPS_SERVER_KEY) in the mobile app.

# MAP-2A — RTDB URL (public hostname; Auth+ACL enforce access). Staging default:
# ORA_FIREBASE_DATABASE_URL=https://ora-app-d8112-default-rtdb.asia-southeast1.firebasedatabase.app

# Disposable MapLibre PoC (MapTiler Cloud) — NEVER commit the raw key.
# Prefer --dart-define=MAPLIBRE_TILE_KEY=... or android/local.properties:
# MAPLIBRE_TILE_KEY=
# Alias also accepted: ORA_MAPTILER_API_KEY=
# Without this key the MapLibre PoC fails closed (no invented credentials).
